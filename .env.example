# Copy this file to .env and adjust for your local MySQL server.
# Steps before running `npm start`:
#   1. Open MySQL Workbench or CLI and create/import charityevents_db.sql
#   2. Set DB_PASSWORD below to your MySQL root (or grant user) password
#   3. Run `node server.js`

PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Required — set to your actual MySQL password. Blank = no password.
DB_PASSWORD=
DB_NAME=charityevents_db
